{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "0224bd4d09844fb1bc227b24435cb5ed",
    "m_Title": "Translucidez con Fresnel",
    "m_Content": "Fresnel Effect calcula qué tan inclinada se ve la superficie respecto a la cámara (usa los vectores Normal y View Direction). Un Lerp entre 0.35 y 0.9 lo convierte en Alpha: el centro del cristal es más transparente y los bordes más sólidos. Surface Type = Transparent",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 643.2000122070313,
        "y": 960.7999877929688,
        "width": 317.5999755859375,
        "height": 108.800048828125
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "078739b6edee4316a8e75999bab0b999",
    "m_Title": "Propiedad DistanciaJugador",
    "m_Content": "Float expuesto con Reference _DistanciaJugador. No se edita a mano: lo escribe el script. Guarda la distancia en metros entre el jugador y el vagón.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 456.0,
        "y": 33.60000228881836,
        "width": 340.71044921875,
        "height": 97.28069305419922
    },
    "m_Group": {
        "m_Id": ""
    }
}

