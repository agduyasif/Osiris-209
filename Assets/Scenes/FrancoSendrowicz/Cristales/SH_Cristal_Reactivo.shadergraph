{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "2172cfa2646d4a5fa205443b6d78ebb3",
    "m_Title": "Inverse Lerp: de distancia a 0-1",
    "m_Content": "Convierte la distancia en un valor entre 0 y 1. A = 15 (distancia máxima, devuelve 0) y B = 2 (distancia mínima, devuelve 1). Entre medio devuelve un valor proporcional. Más cerca = valor más alto.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 454.4000244140625,
