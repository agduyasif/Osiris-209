{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a1711b9cf92d4b19bdd776c5f635c096",
    "m_Title": "Niebla en los bordes",
    "m_Content": "Distance mide qué tan lejos está cada pixel del centro de la pantalla (0.5, 0.5). Smoothstep crea un degradé entre RadioVineta y 1: vale 0 en el centro y 1 en los bordes. Se multiplica por Intensidad y se usa como T de un segundo Lerp, que mezcla hacia ColorToxico en los bordes.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1859.199951171875,
        "y": 896.0,
