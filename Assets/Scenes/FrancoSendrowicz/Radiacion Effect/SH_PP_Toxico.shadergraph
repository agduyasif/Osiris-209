{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "86dc8647a87e4b1caa7c9f854683063a",
    "m_Title": "URP Sample Buffer",
    "m_Content": "Lee el color de la imagen ya renderizada por la cámara (BlitSource). Se le pasan las UV distorsionadas por la onda, así lo que se lee es la imagen “mareada”. Es lo que permite que un shader modifique toda la pantalla",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1422.39990234375,
        "y": 24.000003814697267,
        "width": 296.0,
        "height": 108.80000305175781
    },
    "m_Group": {
        "m_Id": ""
    }
}

