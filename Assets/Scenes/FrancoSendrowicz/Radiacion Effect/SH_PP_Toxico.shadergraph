{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6baed6c0b66543508ec32f2d5d3baa51",
    "m_Title": "Onda de mareo",
    "m_Content": "Screen Position da la posición de cada pixel en pantalla. Split separa X (R) e Y (G). Se multiplica Y por FrecuenciaOnda y se le suma Time × VelocidadOnda, así la onda se mueve en el tiempo. Sine la convierte en una ola entre -1 y 1. Se multiplica por FuerzaDistorsion e Intensidad y se suma a X: la imagen se mece de lado a lado",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 816.0,
        "y": -70.4000015258789,
        "width": 296.79998779296877,
        "height": 142.40000915527345
    },
    "m_Group": {
        "m_Id": "3d266d3b4618470dab3c74d45ac8b1ae"
    }
}

