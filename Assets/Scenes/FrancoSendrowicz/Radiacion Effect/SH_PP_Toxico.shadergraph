    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "89fc46a68f1c49eb9ecd82fa952f4fdf",
    "m_Title": "Post Proceso Toxico",
    "m_Content": "Fullscreen Shader Graph que se aplica con un Full Screen Pass Renderer Feature. Lee la imagen de la cámara y la modifica. Todo se controla con la propiedad Intensidad (0 = sin efecto, 1 = efecto máximo), que el script ProximidadReaccion sube o baja al entrar o salir de la zona del vagón.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1047.199951171875,
        "y": 607.2000122070313,
        "width": 285.5999755859375,
        "height": 138.4000244140625
    },
    "m_Group": {
        "m_Id": ""
    }
}

